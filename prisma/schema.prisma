generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite не поддерживает enum'ы на уровне БД — роли и статусы заказов
// хранятся как строки; допустимые значения см. в src/lib/constants.ts.
model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  passwordHash String
  phone        String?
  role         String   @default("CUSTOMER")
  createdAt    DateTime @default(now())
  orders       Order[]
  addresses    Address[]
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  city      String
  street    String
  house     String
  apartment String?
  zip       String?
  isDefault Boolean @default(false)
}

model Category {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  products Product[]
}

model Product {
  id          String      @id @default(cuid())
  slug        String      @unique
  title       String
  subtitle    String? // короткий эффект/обещание, напр. "Сияние и увлажнение за 14 дней"
  description String
  // Контентные поля для PDP — каждый пункт с новой строки, формат "Название — описание".
  activeIngredients String?
  howToUse          String?
  volume            String? // напр. "50 мл"
  badge             String? // напр. "Хит продаж", "Новинка"
  // Routine Finder: место товара в уходе. routineRole — не медицинское значение,
  // а тип шага: "cleanse" (очищение) | "active" (активный уход) | "care" (базовый уход).
  routineStep Int?
  routineRole String?
  price       Int // цена в копейках
  oldPrice    Int?
  imageUrl    String
  stock       Int         @default(0)
  isActive    Boolean     @default(true)
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])
  createdAt   DateTime    @default(now())
  orderItems  OrderItem[]
  skinTypes   ProductSkinType[]
  concerns    ProductConcern[]
}

// Справочники Routine Finder — many-to-many, товар может подходить нескольким
// типам кожи/потребностям одновременно (не строка с "|").
model SkinType {
  id       String            @id @default(cuid())
  slug     String            @unique
  name     String
  products ProductSkinType[]
}

model Concern {
  id       String           @id @default(cuid())
  slug     String           @unique
  name     String
  products ProductConcern[]
}

model ProductSkinType {
  productId  String
  skinTypeId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  skinType   SkinType @relation(fields: [skinTypeId], references: [id], onDelete: Cascade)

  @@id([productId, skinTypeId])
}

model ProductConcern {
  productId String
  concernId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  concern   Concern @relation(fields: [concernId], references: [id], onDelete: Cascade)

  @@id([productId, concernId])
}

model Order {
  id              String      @id @default(cuid())
  number          String      @unique
  userId          String?
  user            User?       @relation(fields: [userId], references: [id])
  status          String      @default("NEW")
  customerName    String
  customerEmail   String
  customerPhone   String
  deliveryCity    String
  deliveryAddress String
  comment         String?
  totalAmount     Int // копейки
  items           OrderItem[]
  paymentId       String?
  paymentUrl      String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  title     String
  price     Int
  quantity  Int
}
