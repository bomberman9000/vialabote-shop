# База данных — PostgreSQL (локально, в CI и в продакшене; см. README)
DATABASE_URL="postgresql://vialabote:password@localhost:5432/vialabote?schema=public"

# Telegram-админка (включается, только если заданы ОБА значения)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
# Telegram CMS V2 — только чтение; изменения каталога через бота выключены в коде.

# NextAuth
NEXTAUTH_SECRET="сгенерируйте случайную строку: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# ЮKassa (онлайн-оплата). Оставьте пустыми, чтобы работать без онлайн-оплаты
# (заказ будет оформляться со статусом "оплата при получении").
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""

# Ozon Доставка для своего сайта (docs/ozon-delivery.md). Только server-to-server. Значения — только в окружение
# сервера, в репозиторий не коммитить. Методы доставки принимают ТОЛЬКО OAuth-токен частного приложения (Api-Key там не работает).
# Пустые OZON_APP_CLIENT_ID / OZON_APP_CLIENT_SECRET = доставка Ozon выключена, сайт работает как раньше.
OZON_APP_CLIENT_ID=""
OZON_APP_CLIENT_SECRET=""
# Секрет песочницы того же приложения (api-seller-sandbox.ozon.ru) — для scripts/ozon/sandbox-e2e.ts
OZON_APP_CLIENT_SECRET_SANDBOX=""
# prod (по умолчанию) | sandbox. sandbox выключает всё боевое: оплаченные заказы в Ozon не уходят, витрина без Ozon.
OZON_ENV="prod"
# Витрина: "1" — покупатели видят Ozon на оформлении. Без него ключи можно положить и проверить скриптами.
OZON_CHECKOUT_ENABLED=""
# Адрес возврата из настроек частного приложения: страница /ozon-oauth сама обменяет code на токен
OZON_APP_REDIRECT_URI=""
# Уровни доступа для ссылки авторизации (scripts/ozon/oauth.ts url), идентификаторы через пробел
OZON_APP_SCOPE=""
# Необязательно: стартовый refresh_token (дальше он ротируется и живёт в БД, таблица OzonOAuthToken)
OZON_APP_REFRESH_TOKEN=""
# Seller API: Client-Id и Api-Key — для остатков FBS, отправлений и возвратов. Без них эти методы идут с OAuth-токеном.
OZON_CLIENT_ID=""
OZON_API_KEY=""
# Схема: FBS (свой склад, по умолчанию) | FBO | MIX
OZON_DELIVERY_SCHEMA="FBS"
# Запросов в секунду на процесс (не больше 50; квота Ozon общая на все процессы одного Client ID)
OZON_RPS="20"
# Сколько наших прокси дописывают X-Forwarded-For (адрес клиента для ограничителя частоты; см. docs/ozon-delivery.md)
TRUSTED_PROXY_HOPS="1"

# Публичный адрес сайта (для формирования ссылок возврата после оплаты)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Данные администратора, созданного при выполнении `npm run db:seed`
SEED_ADMIN_EMAIL="admin@vialabote.ru"
SEED_ADMIN_PASSWORD="задайте-свой-пароль"
