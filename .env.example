# База данных (SQLite для локальной разработки; для продакшена — Postgres, см. README)
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_SECRET="сгенерируйте случайную строку: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# ЮKassa (онлайн-оплата). Оставьте пустыми, чтобы работать без онлайн-оплаты
# (заказ будет оформляться со статусом "оплата при получении").
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""

# Публичный адрес сайта (для формирования ссылок возврата после оплаты)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Данные администратора, созданного при выполнении `npm run db:seed`
SEED_ADMIN_EMAIL="admin@vialabote.ru"
SEED_ADMIN_PASSWORD="admin12345"
